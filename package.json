{
  "name": "okoct",
  "version": "0.1.0",
  "private": true,
  "description": "OKOCT Health independent health knowledge website",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm validate:content && astro build && pagefind --site dist",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:seo": "node scripts/validate-build.mjs",
    "verify:static": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm validate:content && pnpm test:unit && pnpm test:integration && pnpm build && pnpm validate:seo",
    "verify": "pnpm verify:static && pnpm test:e2e"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "pagefind": "1.6.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.11",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.2",
    "globals": "17.0.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}

---
import "../styles/global.css";

import { getDictionary, type Locale } from "../i18n/config";
import type { RouteKey } from "../i18n/routes";
import {
  buildBreadcrumbJsonLd,
  buildWebPageJsonLd,
  buildWebSiteJsonLd,
  type BreadcrumbItem,
} from "../seo/structured-data";
import { buildSeoMetadata } from "../seo/metadata";
import SeoHead from "../components/SeoHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

interface Props {
  locale: Locale;
  route: RouteKey;
  title: string;
  description: string;
  canonicalPath?: string;
  indexable?: boolean;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  locale,
  route,
  title,
  description,
  canonicalPath,
  indexable,
  breadcrumbs = [],
} = Astro.props;
const dictionary = getDictionary(locale);
const metadata = buildSeoMetadata({
  route,
  locale,
  title,
  description,
  ...(canonicalPath !== undefined ? { canonicalPath } : {}),
  ...(indexable !== undefined ? { indexable } : {}),
});
const jsonLd = [
  buildWebSiteJsonLd(dictionary.home.description),
  buildWebPageJsonLd({
    title,
    description,
    url: metadata.canonical,
    locale,
  }),
  ...(breadcrumbs.length > 0 ? [buildBreadcrumbJsonLd(breadcrumbs)] : []),
];
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <script is:inline>
      (() => {
        const key = "okoct-theme";
        let value;

        try {
          value = window.localStorage.getItem(key) ?? "system";
        } catch {
          value = "system";
        }

        if (value === "light" || value === "dark") {
          document.documentElement.dataset.theme = value;
        }
      })();
    </script>
    <SeoHead metadata={metadata} jsonLd={jsonLd} />
  </head>
  <body
    class="flex min-h-screen flex-col"
    data-pagefind-ignore={indexable === false ? "true" : undefined}
  >
    <a
      href="#main-content"
      class="sr-only absolute left-4 top-4 z-50 rounded-control bg-surface-raised px-4 py-3 text-sm font-semibold text-ink shadow-card focus:not-sr-only"
    >
      {dictionary.ui.skipToContent}
    </a>
    <SiteHeader locale={locale} route={route} />
    <main
      id="main-content"
      tabindex="-1"
      class="flex-1 px-5 py-10 outline-none sm:px-8 sm:py-14 lg:px-10 lg:py-20"
    >
      <Breadcrumbs items={breadcrumbs} />
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>

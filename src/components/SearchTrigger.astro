---
import type { Locale } from "../i18n/config";
import { getDictionary } from "../i18n/dictionaries";
import { getLocalizedPath } from "../i18n/routes";
import Button from "./Button.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const searchPath = getLocalizedPath("search", locale) ?? "#search";
const inputId = `knowledge-search-${locale}`;
---

<form
  role="search"
  aria-label={dictionary.home.searchLabel}
  action={searchPath}
  method="get"
  class="rounded-panel border border-line bg-surface p-5 shadow-card sm:p-6"
>
  <label for={inputId} class="text-sm font-semibold text-ink">{dictionary.home.searchLabel}</label>
  <div class="mt-3 flex flex-col gap-3 sm:flex-row">
    <input
      id={inputId}
      name="q"
      type="search"
      placeholder={dictionary.home.searchPlaceholder}
      class="min-h-11 min-w-0 flex-1 rounded-control border border-line bg-surface-muted px-4 text-ink placeholder:text-ink-muted"
    />
    <Button type="submit">{dictionary.ui.search}</Button>
  </div>
  <p class="mt-3 text-sm leading-6 text-ink-muted">{dictionary.home.searchHint}</p>
</form>

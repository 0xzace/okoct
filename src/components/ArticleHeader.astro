---
interface Props {
  eyebrow?: string | undefined;
  title: string;
  description?: string | undefined;
}

const { eyebrow, title, description } = Astro.props;
---

<header>
  {eyebrow && <p class="text-sm font-semibold tracking-[0.08em] text-brand">{eyebrow}</p>}
  <h1 class="mt-3 font-display text-4xl font-bold tracking-[-0.05em] text-ink sm:text-5xl">{title}</h1>
  {description && <p class="mt-5 text-lg leading-8 text-ink-muted">{description}</p>}
</header>

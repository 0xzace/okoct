---
import { getDictionary } from "../i18n/config";
import { getLocalizedPath, type RouteKey } from "../i18n/routes";
import type { Locale } from "../i18n/config";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeControl from "./ThemeControl.astro";

interface Props {
  locale: Locale;
  route: RouteKey;
}

const { locale, route } = Astro.props;
const dictionary = getDictionary(locale);
const navigationItems = [
  { route: "home" as const, label: dictionary.navigation.home },
  { route: "about" as const, label: dictionary.navigation.about },
  { route: "safety" as const, label: dictionary.navigation.safety },
].flatMap((item) => {
  const href = getLocalizedPath(item.route, locale);

  return href ? [{ ...item, href }] : [];
});
---

<header class="border-b border-line bg-surface-raised">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-4 sm:px-8 lg:flex-row lg:items-center lg:justify-between">
    <a href={getLocalizedPath("home", locale)} class="text-lg font-bold tracking-tight text-brand-strong">
      OKOCT Health
    </a>
    <div class="flex flex-col gap-3 lg:items-end">
      <nav aria-label={dictionary.navigation.home}>
        <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
          {navigationItems.map((item) => (
            <li>
              <a href={item.href} class="underline-offset-4 hover:underline">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="flex flex-wrap items-center gap-4">
        <LanguageSwitcher locale={locale} route={route} />
        <ThemeControl dictionary={dictionary} />
      </div>
    </div>
  </div>
</header>

---
import type { Locale } from "../i18n/config";

interface Props {
  href: string;
  locale: Locale;
}

const { href, locale } = Astro.props;
---

<a
  href={href}
  lang={locale}
  aria-label="OKOCT Health"
  class="group inline-flex items-center gap-3 text-ink no-underline"
>
  <svg
    aria-hidden="true"
    viewBox="0 0 48 48"
    class="h-10 w-10 shrink-0"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect width="48" height="48" rx="13" class="fill-ink" />
    <path d="M10 29h28" class="stroke-brand" stroke-width="2.5" stroke-linecap="round" />
    <path d="M15 29c3.4-8.7 6.2-13 9-13s5.6 4.3 9 13" class="stroke-evidence" stroke-width="2.5" stroke-linecap="round" />
    <circle cx="24" cy="16" r="2.5" class="fill-evidence" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class="font-display text-lg font-bold tracking-[0.04em] text-ink">OKOCT</span>
    <span class="mt-1 text-[0.65rem] font-semibold tracking-[0.28em] text-ink-muted">HEALTH</span>
  </span>
</a>

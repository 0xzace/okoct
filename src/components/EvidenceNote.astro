---
interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props;
---

<aside class="border-l-2 border-evidence pl-5" aria-label={title}>
  <p class="text-sm font-semibold text-evidence-strong">{title}</p>
  <p class="mt-2 text-sm leading-6 text-ink-muted">{text}</p>
</aside>

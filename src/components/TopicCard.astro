---
import Card from "./Card.astro";

interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props;
---

<Card class="group transition-standard border-t-2 border-t-brand hover:-translate-y-1 hover:border-brand-strong hover:shadow-panel">
  <h3 class="font-display text-xl font-semibold tracking-[-0.02em] text-ink">{title}</h3>
  <p class="mt-3 text-sm leading-6 text-ink-muted">{text}</p>
  <span class="mt-6 inline-flex text-sm font-semibold text-brand-strong">{`→`}</span>
</Card>

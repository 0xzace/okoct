---
import { getDictionary } from "../i18n/config";
import { getLocalizedPath, getRouteLocales, type RouteKey } from "../i18n/routes";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
  route: RouteKey;
}

const { locale, route } = Astro.props;
const dictionary = getDictionary(locale);
const languageLinks = getRouteLocales(route).flatMap((candidate) => {
  const href = getLocalizedPath(route, candidate);

  return href ? [{ locale: candidate, href }] : [];
});
---

<nav aria-label={dictionary.languageSwitcherLabel}>
  <ul class="flex flex-wrap items-center gap-1 rounded-pill border border-line bg-surface-muted p-1 text-sm">
    {languageLinks.map((languageLink) => (
      <li>
        <a
          href={languageLink.href}
          hreflang={languageLink.locale}
          lang={languageLink.locale}
          aria-current={languageLink.locale === locale ? "page" : undefined}
          class:list={[
            "transition-standard inline-flex min-h-8 items-center rounded-pill px-3 py-1 underline-offset-4",
            languageLink.locale === locale
              ? "bg-surface text-ink shadow-sm"
              : "text-ink-muted hover:bg-surface hover:text-brand-strong",
          ]}
        >
          {getDictionary(languageLink.locale).languageName}
        </a>
      </li>
    ))}
  </ul>
</nav>

---
import SectionHeading from "./SectionHeading.astro";

interface Props {
  eyebrow: string;
  title: string;
  text: string;
  items: string[];
  headingId?: string | undefined;
}

const { eyebrow, title, text, items, headingId } = Astro.props;
---

<section class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
  <SectionHeading id={headingId} eyebrow={eyebrow} title={title} description={text} />
  <ul class="divide-y divide-line border-y border-line">
    {items.map((item) => (
      <li class="flex gap-4 py-4 text-base leading-7 text-ink">
        <span class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-evidence" aria-hidden="true"></span>
        <span>{item}</span>
      </li>
    ))}
  </ul>
</section>

---
import { getDictionary } from "../i18n/config";
import { getLocalizedPath } from "../i18n/routes";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const safetyPath = getLocalizedPath("safety", locale);
---

<footer class="border-t border-line bg-surface-raised">
  <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-6 text-sm text-ink-muted sm:px-8 sm:flex-row sm:items-center sm:justify-between">
    <p>{dictionary.footer.disclaimer}</p>
    {safetyPath && <a href={safetyPath} class="underline-offset-4 hover:underline">{dictionary.navigation.safety}</a>}
  </div>
</footer>

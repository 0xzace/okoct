---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  id?: string | undefined;
  class?: string;
}

const { eyebrow, title, description, id, class: className = "" } = Astro.props;
---

<header class={`max-w-2xl ${className}`}>
  <p class="text-sm font-semibold tracking-[0.08em] text-brand">{eyebrow}</p>
  <h2 id={id} class="mt-3 font-display text-3xl font-bold tracking-[-0.03em] text-ink sm:text-4xl">
    {title}
  </h2>
  {description && <p class="mt-4 text-base leading-7 text-ink-muted sm:text-lg">{description}</p>}
</header>

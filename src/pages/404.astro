---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  locale="en"
  route="home"
  canonicalPath="/404/"
  indexable={false}
  title="Page not found — OKOCT Health"
  description="The requested OKOCT Health page could not be found."
>
  <section class="mx-auto max-w-2xl py-10">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand">404</p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-ink">Page not found</h1>
    <p class="mt-4 text-lg leading-8 text-ink-muted">The requested page does not exist.</p>
    <a href="/" class="mt-8 inline-flex rounded-md bg-brand px-4 py-2 font-semibold text-white no-underline hover:bg-brand-strong">Return to language entry</a>
  </section>
</BaseLayout>

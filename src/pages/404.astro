---
import Button from "../components/Button.astro";
import ErrorLayout from "../layouts/ErrorLayout.astro";
---

<ErrorLayout
  title="Page not found — OKOCT Health"
  description="The requested OKOCT Health page could not be found."
>
  <section class="py-10">
    <p class="text-sm font-semibold tracking-[0.08em] text-brand">404</p>
    <h1 class="mt-4 font-display text-4xl font-bold tracking-[-0.05em] text-ink">Page not found</h1>
    <p class="mt-4 max-w-xl text-lg leading-8 text-ink-muted">The requested page does not exist.</p>
    <Button href="/" class="mt-8">Return to language entry</Button>
  </section>
</ErrorLayout>

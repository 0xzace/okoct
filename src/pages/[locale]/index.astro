---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { LOCALE_PREFIXES, SUPPORTED_LOCALES, type Locale } from "../../i18n/config";
import { getDictionary } from "../../i18n/dictionaries";
import { getLocalizedPath } from "../../i18n/routes";
import Container from "../../components/Container.astro";
import ContentGrid from "../../components/ContentGrid.astro";
import EditorialStandards from "../../components/EditorialStandards.astro";
import FeaturedContent from "../../components/FeaturedContent.astro";
import HeroPanel from "../../components/HeroPanel.astro";
import SafetyNotice from "../../components/SafetyNotice.astro";
import SearchTrigger from "../../components/SearchTrigger.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import TopicCard from "../../components/TopicCard.astro";
import { getPublishedArticlesForLocale } from "../../utils/home-content";
import { PUBLICATION_CONTEXT } from "../../content-engine/repository/publication-context";

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({
    params: { locale: LOCALE_PREFIXES[locale] },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const dictionary = getDictionary(locale);
const aboutPath = getLocalizedPath("about", locale);
const safetyPath = getLocalizedPath("safety", locale);
const articleEntries = await getCollection("articles");
const publishedArticles = getPublishedArticlesForLocale(
  articleEntries.map((entry) => entry.data),
  locale,
  PUBLICATION_CONTEXT,
);
---

<BaseLayout locale={locale} route="home" title={`${dictionary.home.title} — OKOCT Health`} description={dictionary.home.description}>
  <article class="home-sections">
    <section>
      <Container>
        <HeroPanel
          eyebrow={dictionary.home.eyebrow}
          title={dictionary.home.title}
          description={dictionary.home.description}
          primaryHref={getLocalizedPath("search", locale) ?? "#knowledge-search"}
          primaryLabel={dictionary.home.exploreLabel}
          secondaryHref={aboutPath ?? "#editorial-standards"}
          secondaryLabel={dictionary.home.secondaryLabel}
          horizon={dictionary.home.horizon}
        />
      </Container>
    </section>

    <section id="knowledge-search" aria-labelledby="knowledge-search-title">
      <Container class="max-w-5xl">
        <div class="grid gap-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-center">
          <SectionHeading
            id="knowledge-search-title"
            eyebrow={dictionary.home.searchLabel}
            title={dictionary.home.searchLabel}
            description={dictionary.home.searchHint}
          />
          <SearchTrigger locale={locale} />
        </div>
      </Container>
    </section>

    <section aria-labelledby="topic-title">
      <Container>
        <SectionHeading
          id="topic-title"
          eyebrow={dictionary.home.topicEyebrow}
          title={dictionary.home.topicTitle}
          description={dictionary.home.topicDescription}
        />
        <ContentGrid class="mt-8">
          {dictionary.home.topicCards.map((topic) => <TopicCard title={topic.title} text={topic.text} />)}
        </ContentGrid>
      </Container>
    </section>

    {publishedArticles.length > 0 && (
      <section aria-labelledby="featured-title">
        <Container>
          <FeaturedContent
            headingId="featured-title"
            eyebrow={dictionary.home.featuredEyebrow}
            title={dictionary.home.featuredTitle}
            description={dictionary.home.featuredDescription}
            articles={publishedArticles}
          />
        </Container>
      </section>
    )}

    <section aria-labelledby="safety-title">
      <Container>
        <SafetyNotice
          id="safety-title"
          title={dictionary.home.safetyTitle}
          text={dictionary.home.safetyText}
          href={safetyPath}
          linkLabel={dictionary.home.safetyAction}
        />
      </Container>
    </section>

    <section id="editorial-standards" aria-labelledby="standards-title">
      <Container>
        <EditorialStandards
          headingId="standards-title"
          eyebrow={dictionary.home.standardsEyebrow}
          title={dictionary.home.standardsTitle}
          text={dictionary.home.standardsText}
          items={dictionary.home.standardsItems}
        />
      </Container>
    </section>
  </article>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LOCALE_PREFIXES, SUPPORTED_LOCALES, type Locale } from "../../i18n/config";
import { getDictionary } from "../../i18n/dictionaries";
import { getLocalizedPath } from "../../i18n/routes";

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({
    params: { locale: LOCALE_PREFIXES[locale] },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const dictionary = getDictionary(locale);
const aboutPath = getLocalizedPath("about", locale);
---

<BaseLayout locale={locale} route="home" title={`${dictionary.home.title} — OKOCT Health`} description={dictionary.home.description}>
  <article class="space-y-12">
    <header class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand">{dictionary.home.eyebrow}</p>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-ink sm:text-6xl">{dictionary.home.title}</h1>
      <p class="mt-6 text-lg leading-8 text-ink-muted">{dictionary.home.description}</p>
      {aboutPath && <a href={aboutPath} class="mt-8 inline-flex rounded-md bg-brand px-4 py-2 font-semibold text-white no-underline hover:bg-brand-strong">{dictionary.home.exploreLabel}</a>}
    </header>
    <div class="grid gap-5 md:grid-cols-2">
      <section class="rounded-2xl border border-line bg-surface-raised p-6 shadow-sm">
        <h2 class="text-xl font-semibold text-ink">{dictionary.home.scopeLabel}</h2>
        <p class="mt-3 leading-7 text-ink-muted">{dictionary.home.scopeText}</p>
      </section>
      <section class="rounded-2xl border border-line bg-surface-raised p-6 shadow-sm">
        <h2 class="text-xl font-semibold text-ink">{dictionary.home.statusLabel}</h2>
        <p class="mt-3 leading-7 text-ink-muted">{dictionary.home.statusText}</p>
      </section>
    </div>
  </article>
</BaseLayout>
